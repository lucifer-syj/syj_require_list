{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "syj_require_list",
  "version": "0.1.0",
  "identifier": "com.administrator.syj_require_list",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Todo List",
        "width": 500,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "transparent": false,
        "center": false,
        "x": 100,
        "y": 100,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "main-capability",
          "windows": ["main"],
          "permissions": [
            "core:window:allow-close",
            "core:window:allow-start-dragging",
            "core:window:allow-set-position",
            "core:window:allow-outer-position",
            "core:window:allow-current-monitor",
            "core:window:allow-available-monitors",
            "core:window:allow-set-always-on-top",
            "dialog:allow-open",
            "dialog:allow-confirm",
            "fs:allow-read-file",
            {
              "identifier": "fs:scope",
              "allow": [
                { "path": "$APPLOCALDATA/syj_require_list/**" }
              ]
            }
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
